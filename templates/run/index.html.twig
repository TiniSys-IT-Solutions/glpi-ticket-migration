{% include '@ticketmigration/layout/tabs.html.twig' %}
<div class="container-fluid px-3 pb-3"><div class="card"><div class="card-header d-flex justify-content-between align-items-center"><h2 class="card-title">{{ __('Migration runs', 'ticketmigration') }}</h2>{% if profile_filter %}<a class="btn btn-sm btn-outline-secondary" href="{{ tabs.runs_url }}"><i class="ti ti-filter-off me-1"></i>{{ __('Clear profile filter', 'ticketmigration') }}</a>{% endif %}</div><div class="table-responsive"><table class="table table-hover"><thead><tr><th>#</th><th>{{ __('Source', 'ticketmigration') }}</th><th>{{ __('Mode', 'ticketmigration') }}</th><th>{{ __('Status', 'ticketmigration') }}</th><th>{{ __('Progress', 'ticketmigration') }}</th><th>{{ __('Imported', 'ticketmigration') }}</th><th>{{ __('Errors', 'ticketmigration') }}</th><th></th></tr></thead><tbody>
{% for run in runs %}<tr><td>{{ run.id }}</td><td>{{ run.source_filename }}</td><td>{{ run.mode_label }}</td><td><span class="badge {{ run.status_class }}">{{ run.status_label }}</span></td><td>{{ run.processed_rows }}/{{ run.total_rows }}</td><td>{{ run.success_count }}</td><td>{{ run.failed_count }}</td><td>{% if run.sourcefiles_id %}<a class="btn btn-sm btn-outline-primary" href="{{ run_url }}{{ run.id }}">{{ __('Open', 'ticketmigration') }}</a>{% else %}<span class="text-muted">{{ __('Legacy trace', 'ticketmigration') }}</span>{% endif %}</td></tr>{% else %}<tr><td colspan="8" class="text-center text-muted">{{ __('No migration run yet.', 'ticketmigration') }}</td></tr>{% endfor %}
</tbody></table></div></div></div>
