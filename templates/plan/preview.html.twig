<div class="card m-3">
  <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div><h2 class="card-title">{{ __('Migration plan preview', 'ticketmigration') }}</h2><div class="text-muted">{{ profile.name }} — {{ source.source_filename }}</div></div>
    <div class="btn-group" role="group" aria-label="{{ __('CSV row navigation', 'ticketmigration') }}">
      {% if previous_url %}<a class="btn btn-outline-primary" href="{{ previous_url }}"><i class="ti ti-arrow-left me-1"></i>{{ __('Previous row', 'ticketmigration') }}</a>{% else %}<button class="btn btn-outline-secondary" disabled><i class="ti ti-arrow-left me-1"></i>{{ __('Previous row', 'ticketmigration') }}</button>{% endif %}
      <span class="btn btn-outline-secondary disabled">{{ __('Data row %s', 'ticketmigration')|format(row_position) }}</span>
      {% if next_url %}<a class="btn btn-primary" href="{{ next_url }}">{{ __('Next row', 'ticketmigration') }}<i class="ti ti-arrow-right ms-1"></i></a>{% else %}<button class="btn btn-outline-secondary" disabled>{{ __('Next row', 'ticketmigration') }}<i class="ti ti-arrow-right ms-1"></i></button>{% endif %}
    </div>
  </div>
  <div class="card-body">
    <div class="alert alert-info">{{ __('This is a read-only plan preview. No GLPI ticket or business object has been created.', 'ticketmigration') }}</div>
    {% if plan %}
      <div class="row g-3 mb-3">
        <div class="col-lg-3 col-md-6"><div class="card h-100"><div class="card-body"><div class="text-muted">{{ __('CSV source row', 'ticketmigration') }}</div><div class="h2 mb-0">{{ row.number }}</div></div></div></div>
        <div class="col-lg-3 col-md-6"><div class="card h-100 {{ (plan.errors|length + plan.warnings|length) ? 'border-danger' : 'border-success' }}"><div class="card-body"><div class="text-danger"><i class="ti ti-alert-triangle me-1"></i>{{ __('Alerts', 'ticketmigration') }}</div><div class="h2 mb-0">{{ plan.errors|length + plan.warnings|length }}</div></div></div></div>
        <div class="col-lg-3 col-md-6"><div class="card h-100 {{ plan.information|length ? 'border-info' : '' }}"><div class="card-body"><div class="text-info"><i class="ti ti-info-circle me-1"></i>{{ __('Information', 'ticketmigration') }}</div><div class="h2 mb-0">{{ plan.information|length }}</div></div></div></div>
        <div class="col-lg-3 col-md-6"><div class="card h-100 {{ plan.validations|length ? 'border-success' : '' }}"><div class="card-body"><div class="text-success"><i class="ti ti-circle-check me-1"></i>{{ __('Validated', 'ticketmigration') }}</div><div class="h2 mb-0">{{ plan.validations|length }}</div></div></div></div>
      </div>
      <h3>{{ __('Essential resolved information', 'ticketmigration') }}</h3>
      <div class="row g-3 mb-4">
        {% set checks = [
          {'key': 'requester', 'title': __('Requester', 'ticketmigration'), 'icon': 'ti-user', 'values': summary.requesters, 'source': source_values['actor.requester']|default('')},
          {'key': 'assignee', 'title': __('Assigned technician', 'ticketmigration'), 'icon': 'ti-user-cog', 'values': summary.assignees, 'source': source_values['actor.assignee']|default('')},
          {'key': 'location', 'title': __('Location', 'ticketmigration'), 'icon': 'ti-map-pin', 'values': summary.location ? [summary.location] : [], 'source': source_values['ticket.location']|default('')},
          {'key': 'entity', 'title': __('Entity', 'ticketmigration'), 'icon': 'ti-building', 'values': summary.entity ? [summary.entity] : [], 'source': source_values['ticket.entity']|default(source_values['ticket.location']|default(''))}
        ] %}
        {% for check in checks %}
          <div class="col-lg-3 col-md-6"><div class="card h-100 {{ check.values|length ? 'border-success' : 'border-warning' }}"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start"><div class="text-muted"><i class="ti {{ check.icon }} me-1"></i>{{ check.title }}</div><span class="badge {{ check.values|length ? 'bg-success' : 'bg-warning text-dark' }}">{{ check.values|length ? __('Resolved', 'ticketmigration') : __('Not resolved', 'ticketmigration') }}</span></div>
            {% if check.source != '' %}<div class="small text-muted mt-2">{{ __('CSV value: %s', 'ticketmigration')|format(check.source) }}</div>{% endif %}
            {% for value in check.values %}<div class="fw-semibold mt-2 text-break">{{ value }}</div>{% else %}<div class="mt-2 text-muted">{{ __('No GLPI association retained', 'ticketmigration') }}</div>{% endfor %}
            {% if check.key == 'entity' and summary.entity_origin %}<div class="small text-muted mt-2">{{ summary.entity_origin }}</div>{% endif %}
          </div></div></div>
        {% endfor %}
      </div>
      <div class="card border-primary mb-4">
        <div class="card-body">
          <div class="text-muted"><i class="ti ti-heading me-1"></i>{{ __('Resulting GLPI ticket title', 'ticketmigration') }}</div>
          <div class="h3 mb-0 mt-2 text-break">{{ plan.ticket.name|default(__('No title generated', 'ticketmigration')) }}</div>
          {% if source_values['ticket.name']|default('') == '' %}<div class="small text-muted mt-2">{{ __('The CSV title is empty; the configured fallback rule generated this title.', 'ticketmigration') }}</div>{% endif %}
        </div>
      </div>
      {% for error in plan.errors %}<div class="alert alert-danger"><div class="fw-semibold mb-1"><i class="ti ti-alert-circle me-1"></i>{{ __('Alert', 'ticketmigration') }}</div>{{ error }}</div>{% endfor %}
      {% for warning in plan.warnings %}<div class="alert alert-warning"><div class="fw-semibold mb-1"><i class="ti ti-alert-triangle me-1"></i>{{ __('Alert', 'ticketmigration') }}</div>{{ warning }}</div>{% endfor %}
      {% for message in plan.information %}<div class="alert alert-info"><div class="fw-semibold mb-1"><i class="ti ti-info-circle me-1"></i>{{ __('Information', 'ticketmigration') }}</div>{{ message }}</div>{% endfor %}
      {% for message in plan.validations %}<div class="alert alert-success"><div class="fw-semibold mb-1"><i class="ti ti-circle-check me-1"></i>{{ __('Validated', 'ticketmigration') }}</div>{{ message }}</div>{% endfor %}
      <h3>{{ __('Complete immutable migration plan', 'ticketmigration') }}</h3>
      <div class="text-muted mb-2">{{ __('This technical representation remains the authoritative plan used by dry run and execution.', 'ticketmigration') }}</div>
      <pre class="bg-light p-3 border rounded text-wrap">{{ plan_json }}</pre>
    {% else %}<div class="alert alert-warning">{{ __('The CSV contains no data row.', 'ticketmigration') }}</div>{% endif %}
  </div>
  <div class="card-footer d-flex flex-wrap align-items-center gap-2">
    <a class="btn btn-outline-secondary" href="{{ values_url }}"><i class="ti ti-arrow-left me-1"></i>{{ __('Back to value correspondence', 'ticketmigration') }}</a>
    {% if imported_ticket_id > 0 %}
      {% if imported_ticket_url %}<a class="btn btn-success" href="{{ imported_ticket_url }}"><i class="ti ti-ticket me-1"></i>{{ __('Open imported pilot ticket #%s', 'ticketmigration')|format(imported_ticket_id) }}</a>{% else %}<span class="btn btn-outline-success disabled"><i class="ti ti-ticket me-1"></i>{{ __('Pilot ticket #%s imported', 'ticketmigration')|format(imported_ticket_id) }}</span>{% endif %}
      <span class="text-success small"><i class="ti ti-circle-check me-1"></i>{{ __('This row is registered and will be skipped during the final import.', 'ticketmigration') }}</span>
    {% else %}
      <form method="post" action="{{ form_action }}" class="ms-auto" data-pilot-import-form>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}"><input type="hidden" name="row_offset" value="{{ row_position - 1 }}"><input type="hidden" name="import_pilot" value="1">
        <button class="btn btn-success" data-pilot-import-button {% if not can_import_pilot %}disabled{% endif %}><i class="ti ti-ticket me-1"></i><span>{{ __('Import this pilot row', 'ticketmigration') }}</span></button>
      </form>
    {% endif %}
  </div>
</div>
<script>document.querySelector('[data-pilot-import-form]')?.addEventListener('submit',event=>{if(!confirm('{{ __('Create one real GLPI ticket with notifications disabled and register this row as imported?', 'ticketmigration')|e('js') }}')){event.preventDefault();return;}const button=event.currentTarget.querySelector('[data-pilot-import-button]');button.disabled=true;button.querySelector('span').textContent='{{ __('Pilot import in progress…', 'ticketmigration')|e('js') }}';});</script>
