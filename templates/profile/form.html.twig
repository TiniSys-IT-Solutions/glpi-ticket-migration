<div class="card m-3">
  <div class="card-header">
    <h2 class="card-title">{{ profile_id ? __('Edit migration profile', 'ticketmigration') : __('New migration profile', 'ticketmigration') }}</h2>
  </div>
  <form method="post" action="{{ form_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <input type="hidden" name="id" value="{{ profile_id }}">
    <div class="card-body row g-3">
      <div class="col-md-6">
        <label class="form-label" for="profile-name">{{ __('Name') }}</label>
        <input class="form-control" id="profile-name" name="name" required maxlength="255" value="{{ profile.name|default('') }}">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="source-name">{{ __('Logical source name', 'ticketmigration') }}</label>
        <input class="form-control" id="source-name" name="source_name" maxlength="255" value="{{ profile.source_name|default('') }}">
      </div>
      <div class="col-md-6">
        <label class="form-label">{{ __('Default ticket entity', 'ticketmigration') }}</label>
        {{ entity_dropdown|raw }}
        <div class="form-hint">{{ __('Used when neither one unique requester entity nor an explicit migration profile location/entity association is available.', 'ticketmigration') }}</div>
      </div>
      <div class="col-12">
        <label class="form-label" for="profile-comment">{{ __('Comment') }}</label>
        <textarea class="form-control" id="profile-comment" name="comment" rows="3">{{ profile.comment|default('') }}</textarea>
        <input type="hidden" name="is_private" value="0">
      </div>
      <div class="col-md-6 form-check ms-2">
        <input class="form-check-input" type="checkbox" id="is-private" name="is_private" value="1" {% if profile.is_private|default(1) %}checked{% endif %}>
        <label class="form-check-label" for="is-private">{{ __('Private profile', 'ticketmigration') }}</label>
      </div>
    </div>
    <div class="card-footer d-flex flex-wrap align-items-center gap-2">
      <a class="btn btn-outline-secondary" href="{{ profiles_url }}"><i class="ti ti-arrow-left me-1"></i>{{ __('Back to projects', 'ticketmigration') }}</a>
      {% if profile_id %}
        {% if active_source %}
          <a class="btn btn-outline-primary" href="{{ mapping_url }}?profiles_id={{ profile_id }}"><i class="ti ti-adjustments me-1"></i>{{ __('Field mapping', 'ticketmigration') }}</a>
          <a class="btn btn-outline-primary" href="{{ preview_url }}?id={{ active_source.id }}">{{ __('Preview active CSV', 'ticketmigration') }}</a>
          <a class="btn btn-outline-secondary" href="{{ sources_url }}?profiles_id={{ profile_id }}">{{ __('Manage CSV sources', 'ticketmigration') }}</a>
        {% else %}
          <a class="btn btn-outline-primary" href="{{ upload_url }}?profiles_id={{ profile_id }}">{{ __('Upload CSV', 'ticketmigration') }}</a>
        {% endif %}
      {% endif %}
      <button class="btn btn-primary ms-auto" type="submit" name="{{ profile_id ? 'update' : 'add' }}" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save') }}</button>
      {% if profile_id and active_source %}{% if profile.workflow_step == 'values_configured' %}<a class="btn btn-success" href="{{ values_url }}?profiles_id={{ profile_id }}">{{ __('Resume value correspondence', 'ticketmigration') }}<i class="ti ti-arrow-right ms-1"></i></a>{% else %}<a class="btn btn-success" href="{{ mapping_url }}?profiles_id={{ profile_id }}">{{ profile.workflow_step == 'mapping_configured' ? __('Continue to value correspondence', 'ticketmigration') : __('Continue to mapping', 'ticketmigration') }}<i class="ti ti-arrow-right ms-1"></i></a>{% endif %}{% endif %}
    </div>
  </form>
</div>
