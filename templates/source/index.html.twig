<div class="card m-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="card-title">{{ __('CSV source revisions for %s', 'ticketmigration')|format(profile.name) }}</h2>
    {% if can_manage %}<a class="btn btn-primary" href="{{ upload_url }}"><i class="ti ti-upload me-1"></i>{{ __('Upload a new revision', 'ticketmigration') }}</a>{% endif %}
  </div>
  <div class="table-responsive">
    <table class="table table-striped table-hover mb-0">
      <thead><tr><th>{{ __('File') }}</th><th>{{ __('Uploaded at', 'ticketmigration') }}</th><th>{{ __('Size') }}</th><th>{{ __('Status') }}</th><th>{{ __('Actions') }}</th></tr></thead>
      <tbody>
      {% for source in sources %}
        {% set active = source.id == profile.sourcefiles_id %}
        <tr>
          <td><a href="{{ preview_url }}?id={{ source.id }}">{{ source.source_filename }}</a><div class="text-muted small"><code>{{ source.sha256|slice(0, 12) }}…</code></div></td>
          <td>{{ source.uploaded_at }}</td><td>{{ source.filesize|formatted_size }}</td>
          <td><span class="badge {{ active ? 'bg-green' : 'bg-secondary' }}">{{ active ? __('Active source', 'ticketmigration') : __('Previous revision', 'ticketmigration') }}</span></td>
          <td><div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" href="{{ preview_url }}?id={{ source.id }}">{{ __('Preview') }}</a>
            {% if can_manage and not active %}
              <form method="post" action="{{ form_action }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}"><input type="hidden" name="sourcefiles_id" value="{{ source.id }}"><button class="btn btn-sm btn-outline-success" name="activate" value="1">{{ __('Use this source', 'ticketmigration') }}</button></form>
              <form method="post" action="{{ form_action }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}"><input type="hidden" name="sourcefiles_id" value="{{ source.id }}"><button class="btn btn-sm btn-outline-danger" name="delete" value="1">{{ __('Delete') }}</button></form>
            {% endif %}
          </div></td>
        </tr>
      {% else %}<tr><td colspan="5" class="text-center text-muted">{{ __('No CSV source uploaded yet.', 'ticketmigration') }}</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
  <div class="card-footer"><a class="btn btn-outline-secondary" href="{{ profile_url }}">{{ __('Return to profile', 'ticketmigration') }}</a></div>
</div>
