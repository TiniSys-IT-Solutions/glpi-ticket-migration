{% include '@ticketmigration/layout/tabs.html.twig' %}
<div class="container-fluid px-3 pb-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h2 mb-1"><i class="ti ti-transfer me-2"></i>{{ __('Ticket Migration', 'ticketmigration') }}</h1>
      <p class="text-muted mb-0">{{ __('Prepare and validate generic CSV ticket migrations.', 'ticketmigration') }}</p>
    </div>
    <span class="badge bg-blue-lt text-blue">v{{ version }}</span>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted">{{ __('Migration profiles', 'ticketmigration') }}</div>
        <div class="display-6">{{ profiles_count }}</div>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted">{{ __('Active CSV sources', 'ticketmigration') }}</div>
        <div class="display-6">{{ active_sources_count }}</div>
        <div class="small text-muted">{{ __('%s stored revisions', 'ticketmigration')|format(sources_count) }}</div>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted">{{ __('Migration runs', 'ticketmigration') }}</div>
        <div class="display-6">{{ runs_count }}</div>
      </div></div>
    </div>
  </div>

  <div class="alert alert-danger d-flex align-items-start gap-3 mb-3" role="alert">
    <i class="ti ti-database-exclamation fs-1 flex-shrink-0"></i>
    <div>
      <h2 class="h4 mb-1">{{ __('Backup required before any import', 'ticketmigration') }}</h2>
      <p class="mb-1">{{ __('Before running a pilot or final migration, create and verify a recent, restorable backup of the complete GLPI environment.', 'ticketmigration') }}</p>
      <p class="mb-0"><strong>{{ __('At minimum, back up the complete GLPI MySQL database.', 'ticketmigration') }}</strong> {{ __('Also back up GLPI files when documents or attachments may be imported.', 'ticketmigration') }}</p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card h-100">
        <div class="card-header"><h2 class="card-title">{{ __('Migration workflow', 'ticketmigration') }}</h2></div>
        <div class="card-body">
          <ol class="mb-4">
            <li class="mb-2">{{ __('Create a migration profile and save it.', 'ticketmigration') }}</li>
            <li class="mb-2">{{ __('Open the saved profile and select Upload CSV.', 'ticketmigration') }}</li>
            <li class="mb-2">{{ __('Choose the CSV format, upload the file, and verify its bounded preview.', 'ticketmigration') }}</li>
            <li class="mb-2">{{ __('Map positional CSV columns to functional GLPI targets.', 'ticketmigration') }}</li>
            <li class="mb-2">{{ __('Validate controlled values and inspect several immutable row plans.', 'ticketmigration') }}</li>
            <li>{{ __('Create a pilot ticket, then start the resumable final import.', 'ticketmigration') }}</li>
          </ol>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" href="{{ profiles_url }}"><i class="ti ti-list me-1"></i>{{ __('Open profiles', 'ticketmigration') }}</a>
            {% if can_manage_profiles %}
              <a class="btn btn-outline-primary" href="{{ new_profile_url }}"><i class="ti ti-plus me-1"></i>{{ __('New profile', 'ticketmigration') }}</a>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ runs_url }}"><i class="ti ti-history me-1"></i>{{ __('Migration runs', 'ticketmigration') }}</a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-header"><h2 class="card-title">{{ __('System status', 'ticketmigration') }}</h2></div>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span>{{ __('Protected CSV storage', 'ticketmigration') }}</span>
            <span class="badge {{ storage_ready ? 'bg-green-lt text-green' : 'bg-red-lt text-red' }}">
              {{ storage_ready ? __('Ready', 'ticketmigration') : __('Unavailable', 'ticketmigration') }}
            </span>
          </div>
          <code class="d-block text-break">{{ storage_path }}</code>
          <div class="d-flex justify-content-between mt-3"><span>{{ __('Stored CSV payloads', 'ticketmigration') }}</span><strong>{{ storage_report.stored_count }} — {{ storage_report.stored_bytes|formatted_size }}</strong></div>
          <div class="d-flex justify-content-between mt-2"><span>{{ __('Expired unused revisions', 'ticketmigration') }}</span><strong>{{ storage_report.cleanup_count }} — {{ storage_report.cleanup_bytes|formatted_size }}</strong></div>
          {% if can_cleanup_sources and storage_report.cleanup_count > 0 %}<form method="post" action="{{ cleanup_url }}" class="mt-3"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><button class="btn btn-outline-danger btn-sm" name="cleanup_expired" value="1" onclick="return confirm('{{ __('Clean only expired, inactive and unreferenced CSV revisions?', 'ticketmigration')|e('js') }}')"><i class="ti ti-trash me-1"></i>{{ __('Clean expired revisions', 'ticketmigration') }}</button></form>{% endif %}
          <hr>
          <div class="alert alert-success mb-0"><i class="ti ti-circle-check me-1"></i>{{ __('Pilot and resumable final ticket imports are enabled from validated migration profiles.', 'ticketmigration') }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
