<div class="card m-3"><div class="card-header"><div><h2 class="card-title">{{ __('Value correspondence', 'ticketmigration') }}</h2><div class="text-muted">{{ profile.name }} — {{ source.source_filename }}</div></div></div><form method="post" action="{{ form_action }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}"><div class="card-body">
<div class="alert alert-info">{{ __('Unique exact GLPI matches are prepared automatically. Only values requiring a decision are listed below; saving the form validates all prepared and manual decisions.', 'ticketmigration') }}</div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card bg-body-secondary h-100"><div class="card-body"><div class="text-muted">{{ __('Distinct values analyzed', 'ticketmigration') }}</div><div class="display-6">{{ statistics.total }}</div></div></div></div><div class="col-md-3"><div class="card bg-success-lt h-100"><div class="card-body"><div class="text-success">{{ __('Perfect automatic matches', 'ticketmigration') }}</div><div class="display-6 text-success">{{ statistics.automatic }}</div></div></div></div><div class="col-md-3"><div class="card bg-azure-lt h-100"><div class="card-body"><div class="text-azure">{{ __('Saved manual associations', 'ticketmigration') }}</div><div class="display-6 text-azure">{{ statistics.manual }}</div></div></div></div><div class="col-md-3"><div class="card bg-warning-lt h-100"><div class="card-body"><div class="text-warning">{{ __('Decisions remaining', 'ticketmigration') }}</div><div class="display-6 text-warning">{{ statistics.remaining }}</div></div></div></div></div>
{% if last_analysis.source_id|default(0) %}<div class="alert alert-secondary py-2">{{ __('Last saved analysis', 'ticketmigration') }} — {{ last_analysis.filename }}: {{ last_analysis.automatic }} {{ __('automatic', 'ticketmigration') }}, {{ last_analysis.manual|default(0) }} {{ __('manual', 'ticketmigration') }}, {{ last_analysis.remaining }} {{ __('remaining', 'ticketmigration') }}.</div>{% endif %}
<div class="row g-2 mb-4">{% for field in fields %}<div class="col-md-4 col-xl-3"><div class="card h-100"><div class="card-body py-2"><strong>{{ field.label }}</strong><div class="small text-muted">{{ field.automatic_count }} {{ __('automatic', 'ticketmigration') }} · {{ field.manual_count }} {{ __('manual', 'ticketmigration') }} · {{ field.remaining_count }} {{ __('remaining', 'ticketmigration') }}{% if field.omitted_count > 0 %} · {{ field.omitted_count }} {{ __('omitted', 'ticketmigration') }}{% endif %}</div>{% if field.is_multi_actor %}<div class="small text-azure">{{ field.total_count }} {{ __('distinct actors detected after separation', 'ticketmigration') }}</div>{% endif %}</div></div></div>{% endfor %}</div>
{% for field in fields %}<section class="mb-4"><h3 class="h4">{{ field.label }} <span class="text-muted">— {{ field.column }}</span></h3>{% if field.automatic_count > 0 %}<div class="alert alert-success py-2">{{ __('%s perfect matches were prepared automatically and will be validated when this form is saved.', 'ticketmigration')|format(field.automatic_count) }}</div>{% endif %}{% if field.truncated %}<div class="alert alert-warning">{{ __('More than 200 distinct values were found. This field cannot be validated until its mapping strategy is refined.', 'ticketmigration') }}{% if field.can_skip_unresolved %}<label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="skip_unresolved_targets[]" value="{{ field.target_key }}" {% if field.skip_unresolved %}checked{% endif %}><span class="form-check-label">{{ __('Keep resolved associations and omit only unresolved actors', 'ticketmigration') }}</span></label><div class="form-hint">{{ __('Automatic and manual associations remain applied to imported tickets.', 'ticketmigration') }}</div>{% endif %}</div>{% endif %}
{% if field.rows is not empty %}<div class="table-responsive"><table class="table table-striped"><thead><tr><th>{{ __('Source value', 'ticketmigration') }}</th><th>{{ __('GLPI correspondence', 'ticketmigration') }}</th></tr></thead><tbody>{% for row in field.rows %}<tr data-value-row data-saved="{{ row.is_saved ? '1' : '0' }}"><td class="text-wrap"><span>{{ row.source }}</span><div class="mt-2 d-none" data-valid-badge><span class="badge bg-success-lt text-success"><i class="ti ti-circle-check me-1"></i><span data-valid-label></span></span></div></td><td><select class="form-select" name="resolution[{{ row.form_key }}]" data-resolution data-initial-resolution="{{ row.selected }}" {% if not can_manage %}disabled{% endif %}><option value="">{{ __('Select a correspondence', 'ticketmigration') }}</option>{% for key, label in row.options %}<option value="{{ key }}" {% if row.selected == key %}selected{% endif %}>{{ label }}</option>{% endfor %}<option value="ignore" {% if row.selected == 'ignore' %}selected{% endif %}>{{ __('Ignore this source value', 'ticketmigration') }}</option>{% if row.manual_dropdown %}<option value="manual" {% if row.selected == 'manual' %}selected{% endif %}>{{ __('Use the manual GLPI selection below', 'ticketmigration') }}</option>{% endif %}</select>{% if row.options is empty %}<div class="form-hint text-orange" data-no-match>{{ __('No exact or normalized exact GLPI match was found.', 'ticketmigration') }}</div>{% endif %}{% if row.manual_dropdown %}<div class="mt-2 {% if row.selected != 'manual' %}d-none{% endif %}" data-manual-selection><label class="form-label small">{{ __('Search the complete GLPI list', 'ticketmigration') }}</label>{{ row.manual_dropdown|raw }}</div>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="text-success mb-3"><i class="ti ti-circle-check me-1"></i>{{ __('No manual decision is required for this category.', 'ticketmigration') }}</div>{% endif %}</section>{% else %}<div class="alert alert-success">{{ __('No value correspondence is required for the current field mapping.', 'ticketmigration') }}</div>{% endfor %}</div>
<div class="card-footer d-flex flex-wrap gap-2">{% if can_manage %}<button class="btn btn-outline-primary" name="save_draft" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save progress', 'ticketmigration') }}</button><button class="btn btn-primary" name="save_values" value="1"><i class="ti ti-circle-check me-1"></i>{{ __('Validate and continue', 'ticketmigration') }}</button>{% endif %}<a class="btn btn-outline-secondary" href="{{ mapping_url }}">{{ __('Return to field mapping', 'ticketmigration') }}</a>{% if can_preview_plan %}<a class="btn btn-success" href="{{ plan_url }}">{{ __('Preview first migration plan', 'ticketmigration') }}</a>{% else %}<button class="btn btn-outline-secondary" disabled>{{ __('Preview first migration plan', 'ticketmigration') }}</button>{% endif %}</div></form></div>
<script>document.querySelectorAll('[data-value-row]').forEach(row=>{const resolution=row.querySelector('[data-resolution]');const manual=row.querySelector('[data-manual-selection]');const badge=row.querySelector('[data-valid-badge]');const label=row.querySelector('[data-valid-label]');const noMatch=row.querySelector('[data-no-match]');const manualSelect=manual?manual.querySelector('select'):null;const isComplete=()=>resolution.value!==''&&(resolution.value!=='manual'||(manualSelect&&manualSelect.value&&manualSelect.value!=='0'));const refresh=()=>{if(manual)manual.classList.toggle('d-none',resolution.value!=='manual');const complete=isComplete();row.classList.toggle('table-success',complete);row.classList.toggle('border-start',complete);row.classList.toggle('border-success',complete);row.classList.toggle('border-3',complete);resolution.classList.toggle('is-valid',complete);badge.classList.toggle('d-none',!complete);if(noMatch)noMatch.classList.toggle('d-none',complete);if(complete)label.textContent=row.dataset.saved==='1'&&resolution.value===resolution.dataset.initialResolution?'{{ __('Association saved', 'ticketmigration')|e('js') }}':'{{ __('Ready to save', 'ticketmigration')|e('js') }}';};resolution.addEventListener('change',refresh);if(manualSelect)manualSelect.addEventListener('change',()=>{if(manualSelect.value&&manualSelect.value!=='0')resolution.value='manual';refresh();});refresh();});document.querySelector('form[action="{{ form_action }}"]').addEventListener('submit',()=>{document.querySelectorAll('[data-value-row]').forEach(row=>{const resolution=row.querySelector('[data-resolution]');const manual=row.querySelector('[data-manual-selection]');if(resolution.value==='')resolution.disabled=true;if(manual&&resolution.value!=='manual')manual.querySelectorAll('select,input').forEach(input=>input.disabled=true);});});</script>
