<div class="card m-3"><div class="card-header"><div><h2 class="card-title">{{ __('CSV field mapping', 'ticketmigration') }}</h2><div class="text-muted">{{ profile.name }} — {{ source.source_filename }}</div></div></div>
<form method="post" action="{{ form_action }}"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}"><div class="card-body">
<div class="alert alert-info">{{ __('Map each positional CSV column to a functional GLPI target. Unselected columns are explicitly ignored.', 'ticketmigration') }}</div>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>{{ __('CSV column', 'ticketmigration') }}</th><th>{{ __('Sample value', 'ticketmigration') }}</th><th>{{ __('Separator', 'ticketmigration') }}</th><th>{{ __('GLPI target', 'ticketmigration') }}</th><th>{{ __('Historical description', 'ticketmigration') }}</th></tr></thead><tbody>
{% for column in columns %}{% set current = mappings[column.index].target_key|default('') %}<tr data-mapping-row><td><strong>{{ column.index }} — {{ column.name }}</strong></td><td class="text-muted text-wrap">{{ sample_row ? sample_row.values[column.index]|default('') : '' }}</td><td><div data-actor-separator {% if current not in actor_targets %}class="d-none"{% endif %}><select class="form-select form-select-sm" name="multi_delimiter[{{ column.index }}]" {% if not can_manage %}disabled{% endif %}><option value="auto" {% if mappings[column.index].multi_delimiter|default('auto') == 'auto' %}selected{% endif %}>{{ __('Automatic', 'ticketmigration') }}</option><option value="semicolon" {% if mappings[column.index].multi_delimiter|default('') == 'semicolon' %}selected{% endif %}>{{ __('Semicolon') }}</option><option value="comma" {% if mappings[column.index].multi_delimiter|default('') == 'comma' %}selected{% endif %}>{{ __('Comma') }}</option><option value="pipe" {% if mappings[column.index].multi_delimiter|default('') == 'pipe' %}selected{% endif %}>|</option><option value="newline" {% if mappings[column.index].multi_delimiter|default('') == 'newline' %}selected{% endif %}>{{ __('Line break', 'ticketmigration') }}</option></select></div><span class="text-muted {% if current in actor_targets %}d-none{% endif %}" data-no-actor-separator>—</span></td><td><select class="form-select" name="target[{{ column.index }}]" data-target-select {% if not can_manage %}disabled{% endif %}><option value="">{{ __('Ignore this column', 'ticketmigration') }}</option>{% for group, targets in target_groups %}<optgroup label="{{ group }}">{% for key, label in targets %}<option value="{{ key }}" {% if current == key %}selected{% endif %}>{{ label }}{% if key in required_targets %} *{% endif %}</option>{% endfor %}</optgroup>{% endfor %}</select></td><td><label class="form-check"><input class="form-check-input" type="checkbox" name="description_excluded_columns[]" value="{{ column.index }}" {% if column.index in description_configuration.excluded_columns %}checked{% endif %}><span class="form-check-label">{{ __('Exclude this column', 'ticketmigration') }}</span></label></td></tr>{% endfor %}</tbody></table></div>
<p class="text-muted mb-0">* {{ __('Required for dry run: external identifier and title.', 'ticketmigration') }}</p><hr><h3 class="h4">{{ __('Empty title fallback', 'ticketmigration') }}</h3><p class="text-muted">{{ __('When a mapped title is empty, generate "Ticket —" followed by the first words of the main description. If the description is also empty, use the external identifier.', 'ticketmigration') }}</p><div class="row g-3 mb-3"><div class="col-md-6"><label class="form-check"><input class="form-check-input" type="checkbox" name="title_fallback_enabled" value="1" {% if title_fallback_configuration.enabled %}checked{% endif %}><span class="form-check-label">{{ __('Generate a title when the mapped value is empty', 'ticketmigration') }}</span></label></div><div class="col-md-3"><label class="form-label" for="title-fallback-word-count">{{ __('Description words in generated title', 'ticketmigration') }}</label><input class="form-control" id="title-fallback-word-count" type="number" name="title_fallback_word_count" min="3" max="30" value="{{ title_fallback_configuration.word_count }}"></div></div><hr><h3 class="h4">{{ __('Description consolidation', 'ticketmigration') }}</h3><p class="text-muted">{{ __('Mapped and unmapped source fields can be consolidated into the GLPI ticket description. The main description remains a separate, clearly identified section.', 'ticketmigration') }}</p>
<div class="row g-3"><div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="description_enabled" value="1" {% if description_configuration.enabled %}checked{% endif %}><span class="form-check-label">{{ __('Build a structured historical description', 'ticketmigration') }}</span></label></div><div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="description_include_mapped" value="1" {% if description_configuration.include_mapped %}checked{% endif %}><span class="form-check-label">{{ __('Include mapped fields', 'ticketmigration') }}</span></label></div><div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="description_include_unmapped" value="1" {% if description_configuration.include_unmapped %}checked{% endif %}><span class="form-check-label">{{ __('Include unmapped fields', 'ticketmigration') }}</span></label></div><div class="col-md-6"><label class="form-label" for="description-position">{{ __('Historical data position', 'ticketmigration') }}</label><select class="form-select" id="description-position" name="description_position"><option value="before" {% if description_configuration.position == 'before' %}selected{% endif %}>{{ __('Before the main description', 'ticketmigration') }}</option><option value="after" {% if description_configuration.position == 'after' %}selected{% endif %}>{{ __('After the main description', 'ticketmigration') }}</option></select></div></div></div>
<div class="card-footer d-flex flex-wrap gap-2">{% if can_manage %}<button class="btn btn-primary" name="save_mapping" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save mapping', 'ticketmigration') }}</button>{% endif %}<a class="btn btn-outline-secondary" href="{{ profile_url }}">{{ __('Return to profile', 'ticketmigration') }}</a><a class="btn btn-outline-secondary" href="{{ sources_url }}">{{ __('Manage CSV sources', 'ticketmigration') }}</a>{% if can_continue %}<a class="btn btn-success" href="{{ values_url }}">{{ __('Continue to value correspondence', 'ticketmigration') }}</a>{% else %}<button class="btn btn-outline-secondary" disabled>{{ __('Complete required mappings to continue', 'ticketmigration') }}</button>{% endif %}</div></form></div>
<script>(()=>{const actors={{ actor_targets|json_encode|raw }};document.querySelectorAll('[data-mapping-row]').forEach(row=>{const target=row.querySelector('[data-target-select]');const refresh=()=>{const active=actors.includes(target.value);row.querySelector('[data-actor-separator]').classList.toggle('d-none',!active);row.querySelector('[data-no-actor-separator]').classList.toggle('d-none',active);};target.addEventListener('change',refresh);refresh();});})();</script>
