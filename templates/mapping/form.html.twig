<div class="card m-3">
  <div class="card-header">
    <div><h2 class="card-title">{{ __('CSV field mapping', 'ticketmigration') }}</h2><div class="text-muted">{{ profile.name }} — {{ source.source_filename }}</div></div>
  </div>
  <form method="post" action="{{ form_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"><input type="hidden" name="profiles_id" value="{{ profile.id }}">
    <div class="card-body">
      <div class="alert alert-info">{{ __('Map each positional CSV column to a functional GLPI target. Unselected columns are explicitly ignored.', 'ticketmigration') }}</div>
      <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>{{ __('CSV column', 'ticketmigration') }}</th><th>{{ __('Sample value', 'ticketmigration') }}</th><th>{{ __('GLPI target', 'ticketmigration') }}</th></tr></thead>
        <tbody>{% for column in columns %}
          {% set current = mappings[column.index].target_key|default('') %}
          <tr><td><strong>{{ column.index }} — {{ column.name }}</strong></td><td class="text-muted text-wrap">{{ sample_row ? sample_row.values[column.index]|default('') : '' }}</td><td>
            <select class="form-select" name="target[{{ column.index }}]" {% if not can_manage %}disabled{% endif %}>
              <option value="">{{ __('Ignore this column', 'ticketmigration') }}</option>
              {% for group, targets in target_groups %}<optgroup label="{{ group }}">{% for key, label in targets %}<option value="{{ key }}" {% if current == key %}selected{% endif %}>{{ label }}{% if key in required_targets %} *{% endif %}</option>{% endfor %}</optgroup>{% endfor %}
            </select>
          </td></tr>
        {% endfor %}</tbody>
      </table></div>
      <p class="text-muted mb-0">* {{ __('Required for dry run: external identifier and title.', 'ticketmigration') }}</p>
    </div>
    <div class="card-footer d-flex flex-wrap gap-2">
      {% if can_manage %}<button class="btn btn-primary" name="save_mapping" value="1"><i class="ti ti-device-floppy me-1"></i>{{ __('Save mapping', 'ticketmigration') }}</button>{% endif %}
      <a class="btn btn-outline-secondary" href="{{ profile_url }}">{{ __('Return to profile', 'ticketmigration') }}</a>
      <a class="btn btn-outline-secondary" href="{{ sources_url }}">{{ __('Manage CSV sources', 'ticketmigration') }}</a>
      <button class="btn btn-outline-secondary" disabled title="{{ __('Dry run is the next development step.', 'ticketmigration') }}">{{ __('Continue to dry run', 'ticketmigration') }}</button>
    </div>
  </form>
</div>
